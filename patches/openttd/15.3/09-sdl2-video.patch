+/** RISC OS diagnostics: with -d driver=1 or higher, every 10 seconds log the
+ * heap dynamic area size, the number/size of ARMEABISupport mmap areas and the
+ * free memory pool (stderr, which !Run sends to <Wimp$ScrapDir>.OpenTTDlog). */
+static void RiscOsMemoryReport()
+{
+	if (_debug_driver_level < 1) return;
+	static auto next = std::chrono::steady_clock::now();
+	auto now = std::chrono::steady_clock::now();
+	if (now < next) return;
+	next = now + std::chrono::seconds(10);
+
+	unsigned int heap = 0, mmap_total = 0, mmap_count = 0, free_pool = 0;
+	int area = -1;
+	for (int guard = 0; guard < 4096; guard++) {
+		if (_swix(OS_DynamicArea, _INR(0, 1) | _OUT(1), 3, area, &area) != nullptr || area == -1) break;
+		unsigned int size = 0;
+		const char *name = nullptr;
+		if (_swix(OS_DynamicArea, _INR(0, 1) | _OUT(2) | _OUT(8), 2, area, &size, &name) != nullptr || name == nullptr) continue;
+		std::string_view sv_name(name);
+		if (sv_name.starts_with("OpenTTD Heap")) heap += size;
+		if (sv_name.starts_with("mmap")) { mmap_total += size; mmap_count++; }
+	}
+	_swix(OS_ReadDynamicArea, _IN(0) | _OUT(1), 6, &free_pool);
+	static uint64_t t0 = 0;
+	uint64_t secs = std::chrono::duration_cast<std::chrono::seconds>(now.time_since_epoch()).count();
+	if (t0 == 0) t0 = secs;
+	Debug(driver, 1, "RISC OS memory t={}s: heap DA {} KB, mmap areas {} ({} KB), free {} KB",
+		secs - t0, heap / 1024, mmap_count, mmap_total / 1024, free_pool / 1024);
+}
+
+static std::thread::id _riscos_main_thread;
+
+/**
+ * Called from the file reading code (RandomAccessFile). Loading the graphics
+ * and sounds at startup takes a while before the main loop first polls, and a
+ * desktop window that isn't polled freezes the whole desktop. So, on the main
+ * thread and at most every 50 ms, let SDL poll the Wimp; the events wait in
+ * SDL's queue for the main loop.
+ */
+void RiscOsKeepDesktopAlive()
+{
+	static auto next = std::chrono::steady_clock::time_point();
+	if (SDL_WasInit(SDL_INIT_VIDEO) == 0 || std::this_thread::get_id() != _riscos_main_thread) return;
+	auto now = std::chrono::steady_clock::now();
+	if (now < next) return;
+	next = now + std::chrono::milliseconds(50);
+	SDL_PumpEvents();
+}
+
+/** Wimp handle of the "Loading" box, or 0 when it isn't open. */
+static int _riscos_loading_window = 0;
+
+/**
+ * RISC OS: open a small desktop box saying the game is loading, in the
+ * middle of the screen. Between the video driver starting (when the game's
+ * window and icon bar icon appear) and the first frame the window would
+ * otherwise be black, for 10 seconds or more with a lot of content. The
+ * box is all icons and the Wimp redraws it itself, so SDL, which polls the
+ * Wimp for this task, needn't know about it (it only moves it when asked).
+ * Only in a desktop window: full screen has no desktop to show it on.
+ */
+static void RiscOsShowLoadingWindow()
+{
+	if (_riscos_loading_window != 0) return;
+
+	/* The screen's size in OS units. */
+	int xeig = 1, yeig = 1, xlimit = 0, ylimit = 0;
+	_swix(OS_ReadModeVariable, _INR(0, 1) | _OUT(2), -1, 4, &xeig);
+	_swix(OS_ReadModeVariable, _INR(0, 1) | _OUT(2), -1, 5, &yeig);
+	_swix(OS_ReadModeVariable, _INR(0, 1) | _OUT(2), -1, 11, &xlimit);
+	_swix(OS_ReadModeVariable, _INR(0, 1) | _OUT(2), -1, 12, &ylimit);
+	const int screen_w = (xlimit + 1) << xeig, screen_h = (ylimit + 1) << yeig;
+
+	static char text[] = "Loading OpenTTD, please wait...";
+	const int w = 640, h = 112;
+	int block[23 + 8] = {};
+	block[0] = (screen_w - w) / 2;      // visible area
+	block[1] = (screen_h - h) / 2;
+	block[2] = block[0] + w;
+	block[3] = block[1] + h;
+	block[6] = -1;                      // open on top
+	block[7] = (int)((1u << 31) | (1u << 26) | (1u << 4) | (1u << 1)); // new flags, title bar, auto-redraw, moveable
+	block[8] = 7 | (2 << 8) | (7 << 16) | (1 << 24); // title fg/bg, work area fg/bg
+	block[9] = 3 | (1 << 8) | (12 << 16);           // scroll bar colours, title highlight
+	block[10] = 0;                      // work area: 0, -h, w, 0
+	block[11] = -h;
+	block[12] = w;
+	block[13] = 0;
+	block[14] = 0x3D;                   // title: text, border, centred, filled
+	block[15] = 0;                      // work area clicks ignored
+	block[16] = 1;                      // the Wimp's sprite area
+	block[17] = 0;                      // no minimum size
+	std::copy_n("OpenTTD", 8, reinterpret_cast<char *>(&block[18]));
+	block[21] = 1;                      // one icon:
+	block[22] = 0;                      // its bounding box
+	block[23] = -h;
+	block[24] = w;
+	block[25] = 0;
+	block[26] = (int)(1u | (1u << 3) | (1u << 4) | (1u << 8) | (7u << 24) | (1u << 28)); // indirected text, centred, black on grey
+	block[27] = (int)text;
+	block[28] = -1;                     // no validation string
+	block[29] = sizeof(text);
+
+	int handle = 0;
+	if (_swix(Wimp_CreateWindow, _IN(1) | _OUT(0), &block[0], &handle) != nullptr) return;
+	int open[8] = { handle, block[0], block[1], block[2], block[3], 0, 0, -1 };
+	if (_swix(Wimp_OpenWindow, _IN(1), open) != nullptr) {
+		_swix(Wimp_DeleteWindow, _IN(1), &handle);
+		return;
+	}
+	_riscos_loading_window = handle;
+	SDL_PumpEvents(); // let the Wimp draw it, and the game's window and icon
+}
+
+/** RISC OS: close the "Loading" box, if it's open. */
+static void RiscOsHideLoadingWindow()
+{
+	if (_riscos_loading_window == 0) return;
+	_swix(Wimp_DeleteWindow, _IN(1), &_riscos_loading_window);
+	_riscos_loading_window = 0;
+}
