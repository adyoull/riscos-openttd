--- a/src/random_access_file.cpp
+++ b/src/random_access_file.cpp
@@ -42,6 +42,11 @@ RandomAccessFile::RandomAccessFile(std::string_view filename, Subdirectory subdi
 	this->simplified_filename = name_without_path.substr(0, name_without_path.rfind('.'));
 	strtolower(this->simplified_filename);
 
+#if defined(__riscos__)
+	/* Nothing buffered yet, and a position SeekTo can't mistake for the current one. */
+	this->buffer = this->buffer_end = this->buffer_start;
