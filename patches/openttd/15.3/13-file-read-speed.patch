 class RandomAccessFile {
 	/** The number of bytes to allocate for the buffer. */
+#if defined(__riscos__)
+	/* Every read and seek is a filing system call on RISC OS, and loading the
+	 * sprite tables jumps back and forth within a few KB: a larger buffer that
+	 * seeks inside itself turns ~45,000 calls at startup into a few hundred. */
+	static constexpr int BUFFER_SIZE = 32768;
+#else
 	static constexpr int BUFFER_SIZE = 512;
+#endif
 
 	std::string filename;            ///< Full name of the file; relative path to subdir plus the extension of the file.
 	std::string simplified_filename; ///< Simplified lowercase name of the file; only the name, no path or extension.
