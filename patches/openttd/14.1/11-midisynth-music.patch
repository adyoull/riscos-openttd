+/** @file midisynth_m.h Base for music playback with the midisynth library (TinySoundFont). */
+
+#ifndef MUSIC_MIDISYNTH_H
+#define MUSIC_MIDISYNTH_H
+
+#include "music_driver.hpp"
+
+/** Music driver rendering MIDI through a SoundFont with the midisynth library, mixed into the sound output. */
+class MusicDriver_MIDISynth : public MusicDriver {
+public:
+	const char *Start(const StringList &param) override;
+
+	void Stop() override;
+
+	void PlaySong(const MusicSongInfo &song) override;
+
+	void StopSong() override;
+
+	bool IsSongPlaying() override;
+
+	void SetVolume(byte vol) override;
+	const char *GetName() const override { return "midisynth"; }
+};
+
+/** Factory for the midisynth driver. */
+class FMusicDriver_MIDISynth : public DriverFactoryBase {
+public:
+	FMusicDriver_MIDISynth() : DriverFactoryBase(Driver::DT_MUSIC, 5, "midisynth", "SoundFont MIDI Driver (midisynth)") {}
+	Driver *CreateInstance() const override { return new MusicDriver_MIDISynth(); }
+};
+
+#endif /* MUSIC_MIDISYNTH_H */
