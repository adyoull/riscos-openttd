@@ -85,6 +90,20 @@ void RandomAccessFile::SeekTo(size_t pos, int mode)
 {
 	if (mode == SEEK_CUR) pos += this->GetPos();
 
+#if defined(__riscos__)
+	/* The target is inside what's buffered: just move within the buffer. */
+	size_t buffer_pos = this->pos - (this->buffer_end - this->buffer_start);
+	if (pos >= buffer_pos && pos < this->pos) {
+		this->buffer = this->buffer_start + (pos - buffer_pos);
+		return;
+	}
+	/* The target is where the file already is: no seek needed. */
+	if (pos == this->pos) {
+		this->buffer = this->buffer_end = this->buffer_start;
+		return;
+	}
+#endif
+
 	this->pos = pos;
 	if (fseek(this->file_handle, this->pos, SEEK_SET) < 0) {
 		Debug(misc, 0, "Seeking in {} failed", this->filename);
@@ -98,9 +117,16 @@ void RandomAccessFile::SeekTo(size_t pos, int mode)
  * Read a byte from the file.
  * @return Read byte.
  */
+#if defined(__riscos__)
+extern void RiscOsKeepDesktopAlive();
+#endif
+
 byte RandomAccessFile::ReadByte()
 {
 	if (this->buffer == this->buffer_end) {
+#if defined(__riscos__)
+		RiscOsKeepDesktopAlive();
+#endif
 		this->buffer = this->buffer_start;
 		size_t size = fread(this->buffer, 1, RandomAccessFile::BUFFER_SIZE, this->file_handle);
 		this->pos += size;
@@ -138,8 +164,20 @@ uint32_t RandomAccessFile::ReadDword()
  */
 void RandomAccessFile::ReadBlock(void *ptr, size_t size)
 {
+#if defined(__riscos__)
+	/* Use what's already buffered, then read the rest straight from the file. */
+	size_t buffered = std::min<size_t>(size, this->buffer_end - this->buffer);
+	memcpy(ptr, this->buffer, buffered);
+	this->buffer += buffered;
+	size -= buffered;
+	if (size == 0) return;
+	RiscOsKeepDesktopAlive();
+	this->buffer = this->buffer_end = this->buffer_start;
+	this->pos += fread(static_cast<byte *>(ptr) + buffered, 1, size, this->file_handle);
+#else
 	this->SeekTo(this->GetPos(), SEEK_SET);
 	this->pos += fread(ptr, 1, size, this->file_handle);
+#endif
 }
 
