+/**
+ * Search a textfile file next to the given content.
+ * Results are remembered: each lookup probes many file names across every
+ * search path, and opening Game Options does this for every base set file,
+ * which took seconds on slower filing systems (e.g. RISC OS on an SD card).
+ * @param type The type of the textfile to search for.
+ * @param dir The subdirectory to search in.
+ * @param filename The filename of the content to look for.
+ * @return The path to the textfile, \c nullptr otherwise.
+ */
 std::optional<std::string> GetTextfile(TextfileType type, Subdirectory dir, const std::string &filename)
+{
+	static std::map<std::string, std::optional<std::string>> cache;
+	std::string key = fmt::format("{}|{}|{}|{}", (int)type, (int)dir, GetCurrentLanguageIsoCode(), filename);
+	auto it = cache.find(key);
+	if (it != cache.end()) return it->second;
+	auto result = GetTextfileUncached(type, dir, filename);
+	cache[key] = result;
+	return result;
+}
+
