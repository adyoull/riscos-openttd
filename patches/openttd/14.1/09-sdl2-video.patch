+#if defined(__riscos__)
+#include <swis.h>
+/** RISC OS diagnostics: with -d driver=1 or higher, every 10 seconds log the
+ * heap dynamic area size, the number/size of ARMEABISupport mmap areas and the
+ * free memory pool (stderr, which !Run sends to <Wimp$ScrapDir>.OpenTTDlog). */
+static void RiscOsMemoryReport()
+{
+	if (_debug_driver_level < 1) return;
+	static auto next = std::chrono::steady_clock::now();
+	auto now = std::chrono::steady_clock::now();
+	if (now < next) return;
+	next = now + std::chrono::seconds(10);
+
+	unsigned int heap = 0, mmap_total = 0, mmap_count = 0, free_pool = 0;
+	int area = -1;
+	for (int guard = 0; guard < 4096; guard++) {
+		if (_swix(OS_DynamicArea, _INR(0, 1) | _OUT(1), 3, area, &area) != nullptr || area == -1) break;
+		unsigned int size = 0;
+		const char *name = nullptr;
+		if (_swix(OS_DynamicArea, _INR(0, 1) | _OUT(2) | _OUT(8), 2, area, &size, &name) != nullptr || name == nullptr) continue;
+		if (strncmp(name, "OpenTTD Heap", 12) == 0) heap += size;
+		if (strncmp(name, "mmap", 4) == 0) { mmap_total += size; mmap_count++; }
+	}
+	_swix(OS_ReadDynamicArea, _IN(0) | _OUT(1), 6, &free_pool);
+	static uint64_t t0 = 0;
+	uint64_t secs = std::chrono::duration_cast<std::chrono::seconds>(now.time_since_epoch()).count();
+	if (t0 == 0) t0 = secs;
+	Debug(driver, 1, "RISC OS memory t={}s: heap DA {} KB, mmap areas {} ({} KB), free {} KB",
+		secs - t0, heap / 1024, mmap_count, mmap_total / 1024, free_pool / 1024);
+}
+
+static std::thread::id _riscos_main_thread;
+
+/**
+ * Called from the file reading code (RandomAccessFile). Loading the graphics
+ * and sounds at startup takes a while before the main loop first polls, and a
+ * desktop window that isn't polled freezes the whole desktop. So, on the main
+ * thread and at most every 50 ms, let SDL poll the Wimp; the events wait in
+ * SDL's queue for the main loop.
+ */
+void RiscOsKeepDesktopAlive()
+{
+	static auto next = std::chrono::steady_clock::time_point();
+	if (SDL_WasInit(SDL_INIT_VIDEO) == 0 || std::this_thread::get_id() != _riscos_main_thread) return;
+	auto now = std::chrono::steady_clock::now();
+	if (now < next) return;
+	next = now + std::chrono::milliseconds(50);
+	SDL_PumpEvents();
+}
+#endif
