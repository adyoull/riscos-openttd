-#ifndef __EMSCRIPTEN__
+#if defined(__riscos__)
+	/* RISC OS: wait through SDL_Delay, not SleepTillNextTick(). That uses
+	 * std::this_thread::sleep_for, which ends in UnixLib's nanosleep; in a
+	 * desktop task that spins until the time is up, so the game used all of
+	 * the processor between frames. On the main thread in a desktop window
+	 * SDL_Delay waits in Wimp_PollIdle, so other tasks get the time. The
+	 * Wimp counts in centiseconds and SDL rounds to the nearest one, so ask
+	 * only for whole centiseconds that fit; the rest (under 10 ms) is waited
+	 * in steps of at most 4 ms, which SDL does with one Wimp_Poll and a
+	 * short spin. Full screen waits as before. */
+	{
+		auto next_tick = this->next_draw_tick;
+		if (!this->is_game_threaded) next_tick = std::min(next_tick, this->next_game_tick);
+		auto wait = std::chrono::duration_cast<std::chrono::milliseconds>(next_tick - std::chrono::steady_clock::now()).count();
+		if (wait >= 10) {
+			SDL_Delay(static_cast<Uint32>(wait / 10 * 10));
+		} else if (wait > 0) {
+			SDL_Delay(static_cast<Uint32>(std::min<decltype(wait)>(wait, 4)));
+		}
+	}
+#elif !defined(__EMSCRIPTEN__)
 	this->SleepTillNextTick();
 #endif
 }
