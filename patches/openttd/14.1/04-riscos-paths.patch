+#if defined(__riscos__)
+/**
+ * RISC OS: give a tar file with the Tar filetype (&C46) the Data filetype.
+ *
+ * UnixLib gives a new "name/tar" file the type MimeMap has for "tar", which
+ * is &C46. SparkFS claims that type as an image filing system, and its Tar
+ * module then handles the file whenever it's looked at; with OpenTTD's
+ * content tars that module has crashed (a data abort inside it), taking the
+ * game and SparkFS's memory with it. OpenTTD reads its tars itself, so they
+ * don't need to be images. The type is changed before the tar is opened.
+ * @param filename The tar file.
+ */
+static void RiscOsTarAsData(const std::string &filename)
+{
+	char ro_name[1024];
+	if (__riscosify_std(filename.c_str(), 0, ro_name, sizeof(ro_name), nullptr) == nullptr) return;
+
+	int object_type, load;
+	if (_swix(OS_File, _INR(0, 1) | _OUT(0) | _OUT(2), 17, ro_name, &object_type, &load) != nullptr) return;
+	if (object_type == 0 || (static_cast<unsigned>(load) >> 20) != 0xFFF) return; // missing, or no filetype
+	if (((load >> 8) & 0xFFF) != 0xC46) return;
+
+	if (_swix(OS_File, _INR(0, 2), 18, ro_name, 0xFFD) == nullptr) {
+		Debug(misc, 1, "Set {} to the Data filetype, so SparkFS doesn't treat it as an image", filename);
+	}
+}
+#endif
+
 bool TarScanner::AddFile(const std::string &filename, size_t, [[maybe_unused]] const std::string &tar_filename)
 {
+#if defined(__riscos__)
+	RiscOsTarAsData(filename);
+#endif
 	/* No tar within tar. */
 	assert(tar_filename.empty());
 
