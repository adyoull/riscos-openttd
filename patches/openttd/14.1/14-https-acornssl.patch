+/**
+ * @file http_riscos.cpp RISC OS implementation for HTTP requests, using the
+ * AcornSSL module for HTTPS.
+ *
+ * AcornSSL (part of RISC OS 5) runs the TLS handshake and checks the server's
+ * certificate against the system's trusted roots and the host name. On top of
+ * it this file speaks just enough HTTP/1.1 for OpenTTD: a GET or POST, redirects,
+ * and a body delimited by Content-Length, chunked encoding or the connection
+ * closing. It runs on its own thread, like the curl implementation, and uses
+ * non-blocking calls throughout: a SWI that blocks would stop every thread and
+ * the desktop with it.
+ */
+
+#include "../../stdafx.h"
+#include "../../debug.h"
+#include "../../rev.h"
+#include "../../thread.h"
+#include "../network_internal.h"
+
+#include "http.h"
+#include "http_shared.h"
