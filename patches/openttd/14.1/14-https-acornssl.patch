+#include <netdb.h>
+#include <sys/socket.h>
+#include <netinet/in.h>
+
+#include "../../safeguards.h"
+
+/** Build a connection's name for the debug log. */
+#define HTTP_LOG_PREFIX "HTTP (AcornSSL): "
+
+namespace {
+
+using Clock = std::chrono::steady_clock;
+
+/** Result of a read or write on a secure connection. */
+enum class IoResult {
+	Done,      ///< Some data was transferred (or, for a read, the peer closed: see the count).
+	TryAgain,  ///< Nothing yet: the connection is still being set up, or no data is waiting.
+	Error,     ///< The connection failed.
+};
+
+} // namespace
+
+#if defined(OTTD_HTTP_TRANSPORT_HEADER)
+/* Host tests only: a stand-in for AcornSSL with the same interface as SecureConnection below. */
+#	include OTTD_HTTP_TRANSPORT_HEADER
+#else
+
+#include <kernel.h>
+#include <swis.h>
+
+namespace {
+
+/* AcornSSL SWIs (chunk &50F80); see the AcornSSL chapter of the RISC OS 5 PRM. */
+constexpr int XAcornSSL_Creat      = 0x20000 | 0x50F80;
+constexpr int XAcornSSL_Ioctl      = 0x20000 | 0x50F81;
+constexpr int XAcornSSL_Connect    = 0x20000 | 0x50F82;
+constexpr int XAcornSSL_Close      = 0x20000 | 0x50F84;
+constexpr int XAcornSSL_Write      = 0x20000 | 0x50F86;
+constexpr int XAcornSSL_Recv       = 0x20000 | 0x50F87;
+constexpr int XAcornSSL_Setsockopt = 0x20000 | 0x50F8B;
+
+constexpr int SO_ACORNSSL_HOSTNAME = 0x11E0;   ///< Name to check the certificate against, and to send as SNI.
+constexpr int SO_ACORNSSL_PROMPTTIME = 0x11E1; ///< How long the "bad certificate" dialogue waits; 0 = no dialogue, just fail.
+constexpr unsigned int ACORNSSL_FIONBIO = 0x8004667E; ///< _IOW('f', 126, int): set/clear non-blocking.
+
+/* Socket errors come back as RISC OS errors in the DCI4 range, errno in the low byte. */
+constexpr int DCI4_ERROR_BASE = 0x20E00;
+constexpr int DCI4_EWOULDBLOCK = 35;
+constexpr int DCI4_EINPROGRESS = 36;
+constexpr int DCI4_EALREADY = 37;
+constexpr int DCI4_ENOTCONN = 57;
+
+/**
+ * The errno of a failed socket-style SWI, or -1 for any other kind of error
+ * (for example "SWI not known" when AcornSSL isn't loaded).
+ */
+int SwiErrno(const _kernel_oserror *e)
+{
+	if ((e->errnum & ~0xFF) == DCI4_ERROR_BASE) return e->errnum & 0xFF;
+	return -1;
+}
+
+/** A TLS connection through AcornSSL. */
+class SecureConnection {
+public:
+	~SecureConnection() { this->Close(); }
+
+	/**
+	 * Start connecting. The connection and handshake continue in the
+	 * background; Read() and Write() return TryAgain until they're done.
+	 * @param host Host name, for the certificate check and SNI.
+	 * @param address Address to connect to.
+	 * @param address_len Size of the address.
+	 * @return Whether the connection was started.
+	 */
+	bool Open(const std::string &host, const sockaddr *address, socklen_t address_len)
+	{
+		this->host = host; // AcornSSL keeps the pointer, so the string must live as long as the session.
+
+		int handle;
+		const _kernel_oserror *e = _swix(XAcornSSL_Creat, _INR(0, 2) | _OUT(0), AF_INET, SOCK_STREAM, 0, &handle);
+		if (e != nullptr) return this->Fail("can't create a session", e);
+		this->handle = handle;
+
+		int on = 1;
+		const char *name = this->host.c_str();
+		int prompt_time = 0; // Fail on a bad certificate rather than asking; this is a background download.
+		if ((e = _swix(XAcornSSL_Ioctl, _INR(0, 2), this->handle, ACORNSSL_FIONBIO, &on)) != nullptr) return this->Fail("can't make it non-blocking", e);
+		if ((e = _swix(XAcornSSL_Setsockopt, _INR(0, 4), this->handle, SOL_SOCKET, SO_ACORNSSL_HOSTNAME, &name, 4)) != nullptr) return this->Fail("can't set the host name", e);
+		if ((e = _swix(XAcornSSL_Setsockopt, _INR(0, 4), this->handle, SOL_SOCKET, SO_ACORNSSL_PROMPTTIME, &prompt_time, 4)) != nullptr) {
+			/* Not fatal: without it, a bad certificate is shown to the user to accept or reject. */
+			Debug(net, 1, HTTP_LOG_PREFIX "can't turn the certificate prompt off: {}", e->errmess);
+		}
+
+		e = _swix(XAcornSSL_Connect, _INR(0, 2), this->handle, address, address_len);
+		if (e != nullptr) {
+			int err = SwiErrno(e);
+			if (err != DCI4_EINPROGRESS && err != DCI4_EALREADY && err != DCI4_EWOULDBLOCK) return this->Fail("can't connect", e);
+		}
+		return true;
+	}
+
+	/** Send some of \a length bytes; \a done is set to how many went. */
+	IoResult Write(const char *data, size_t length, size_t &done)
+	{
+		int written;
+		const _kernel_oserror *e = _swix(XAcornSSL_Write, _INR(0, 2) | _OUT(0), this->handle, data, (int)length, &written);
+		return this->Result(e, written, done, "sending");
+	}
+
+	/** Receive up to \a length bytes; \a done is set to how many came (0 = the peer closed). */
+	IoResult Read(char *buffer, size_t length, size_t &done)
+	{
+		int received;
+		const _kernel_oserror *e = _swix(XAcornSSL_Recv, _INR(0, 3) | _OUT(0), this->handle, buffer, (int)length, 0, &received);
+		return this->Result(e, received, done, "receiving");
+	}
+
+	void Close()
+	{
+		if (this->handle != -1) _swix(XAcornSSL_Close, _IN(0), this->handle);
+		this->handle = -1;
+	}
+
+	const std::string &GetError() const { return this->error; }
+
+private:
+	int handle = -1;
+	std::string host;
+	std::string error;
+
+	bool Fail(const char *what, const _kernel_oserror *e)
+	{
+		this->error = fmt::format("{}: {} (error &{:X})", what, e->errmess, e->errnum);
+		this->Close();
+		return false;
+	}
+
+	IoResult Result(const _kernel_oserror *e, int count, size_t &done, const char *what)
+	{
+		done = 0;
+		if (e == nullptr) {
+			done = count;
+			return IoResult::Done;
+		}
+		int err = SwiErrno(e);
+		/* Still connecting or handshaking (ENOTCONN), or nothing to do right now. */
+		if (err == DCI4_EWOULDBLOCK || err == DCI4_ENOTCONN || err == DCI4_EINPROGRESS || err == DCI4_EALREADY) return IoResult::TryAgain;
+		this->error = fmt::format("{}: {} (error &{:X})", what, e->errmess, e->errnum);
+		return IoResult::Error;
+	}
+};
+
+} // namespace
+
+#endif /* OTTD_HTTP_TRANSPORT_HEADER */
