+				uint32_t *dst = reinterpret_cast<uint32_t *>(static_cast<uint8_t *>(_sdl_real_surface->pixels) + y * _sdl_real_surface->pitch) + r.x;
+				int x = 0;
+#if defined(__ARM_NEON)
+				/* NEON: 16 pixels at a time, de-interleaving the bytes and
+				 * swapping the red and blue lanes. */
+				for (; x + 16 <= r.w; x += 16) {
+					uint8x16x4_t v = vld4q_u8(reinterpret_cast<const uint8_t *>(src + x));
+					uint8x16_t t = v.val[0];
+					v.val[0] = v.val[2];
+					v.val[2] = t;
+					vst4q_u8(reinterpret_cast<uint8_t *>(dst + x), v);
+				}
+#endif
