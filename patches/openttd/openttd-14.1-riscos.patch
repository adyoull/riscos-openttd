+++ b/src/music/midisynth_m.cpp
@@ -0,0 +1,107 @@
+/*
+ * This file is part of OpenTTD.
+ * OpenTTD is free software; you can redistribute it and/or modify it under the terms of the GNU General Public License as published by the Free Software Foundation, version 2.
+ * OpenTTD is distributed in the hope that it will be useful, but WITHOUT ANY WARRANTY; without even the implied warranty of MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.
+ * See the GNU General Public License for more details. You should have received a copy of the GNU General Public License along with OpenTTD. If not, see <http://www.gnu.org/licenses/>.
+ */
+
+
+/** @file midisynth_m.cpp Playing music with the midisynth library (TinySoundFont), mixed into the sound output. */
+
+#include "../stdafx.h"
+#include "../openttd.h"
+#include "../sound_type.h"
+#include "../debug.h"
+#include "midisynth_m.h"
+#include "midifile.hpp"
+#include <midisynth.h>
+#include "../mixer.h"
+
+#include "../safeguards.h"
+
+/** The synthesiser. midisynth does its own locking. The mixer only calls
+ * RenderMusicStream while it is installed, and MxSetMusicSource waits for
+ * the mixer, so _ms is never destroyed while being rendered. */
+static midisynth *_ms = nullptr;
+
+/** Factory for the midisynth driver. */
+static FMusicDriver_MIDISynth iFMusicDriver_MIDISynth;
+
+/** SoundFonts to try when none is given with -m midisynth:soundfont=<file>. */
+static const char *default_sf[] = {
+	nullptr, // MIDISynth$SoundFont (set by !MIDISynth) / MIDISYNTH_SOUNDFONT
+#if defined(__riscos__)
+	"<OpenTTD$Dir>.SoundFont",
+#endif
+	"/usr/share/sounds/sf2/TimGM6mb.sf2",
+	"/usr/share/sounds/sf2/FluidR3_GM.sf2",
+};
+
+static void RenderMusicStream(int16_t *buffer, size_t samples)
+{
+	if (_ms != nullptr) midisynth_render(_ms, buffer, (int)samples, 1);
+}
+
+const char *MusicDriver_MIDISynth::Start(const StringList &param)
+{
+	const char *sfont_name = GetDriverParam(param, "soundfont");
+
+	/* Find out the sample rate without starting playback yet. */
+	uint32_t samplerate = MxSetMusicSource(nullptr);
+	if (samplerate == 0) return "No sound output to play music through";
+
+	if (sfont_name != nullptr) {
+		_ms = midisynth_create(sfont_name, samplerate);
+	} else {
+		for (const char *sf : default_sf) {
+			_ms = midisynth_create(sf, samplerate);
+			if (_ms != nullptr) break;
+			Debug(driver, 1, "midisynth: {}", midisynth_error());
+		}
+	}
+	if (_ms == nullptr) {
+		Debug(driver, 0, "midisynth: {}", midisynth_error());
+		return "Could not open a SoundFont (install !MIDISynth, or use -m midisynth:soundfont=<file>)";
+	}
+	Debug(driver, 1, "midisynth: samplerate {}", samplerate);
+
+	MxSetMusicSource(RenderMusicStream);
+	return nullptr;
+}
+
+void MusicDriver_MIDISynth::Stop()
+{
+	MxSetMusicSource(nullptr);
+	if (_ms != nullptr) midisynth_destroy(_ms);
+	_ms = nullptr;
+}
+
+void MusicDriver_MIDISynth::PlaySong(const MusicSongInfo &song)
+{
+	if (_ms == nullptr) return;
+
+	std::string filename = MidiFile::GetSMFFile(song);
+	midisynth_stop(_ms);
+	if (filename.empty()) return;
+
+	if (!midisynth_load_file(_ms, filename.c_str())) {
+		Debug(driver, 0, "midisynth: {}", midisynth_error());
+		return;
+	}
+	midisynth_play(_ms);
+}
+
+void MusicDriver_MIDISynth::StopSong()
+{
+	if (_ms != nullptr) midisynth_stop(_ms);
+}
+
+bool MusicDriver_MIDISynth::IsSongPlaying()
+{
+	return _ms != nullptr && midisynth_playing(_ms);
+}
+
+void MusicDriver_MIDISynth::SetVolume(byte vol)
+{
+	if (_ms != nullptr) midisynth_set_volume(_ms, vol / 127.0f);
+}
