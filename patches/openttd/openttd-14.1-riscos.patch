+	FMusicDriver_MIDISynth() : DriverFactoryBase(Driver::DT_MUSIC, 5, "midisynth", "SoundFont MIDI Driver (midisynth)") {}
+	Driver *CreateInstance() const override { return new MusicDriver_MIDISynth(); }
+};
